---
import site from '../config/site';
import { getCounts, fill } from '../lib/tokens';

const counts = await getCounts();
---

<footer class="row foot">
  <div class="cell c6"><span class="mono lbl faint">{fill(site.footer.left, counts)}</span></div>
  <div class="cell c6"><span class="mono lbl faint">{fill(site.footer.right, counts)}</span></div>
</footer>
