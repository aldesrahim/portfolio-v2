---
import site from '../config/site';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<header class="row masthead">
  <div class="cell c12">
    <a class="brand" href="/">{site.nav.brand}</a>
    <nav class="nav mono">
      {
        site.nav.links.map((link) => (
          <a href={link.href} class={link.id && link.id === active ? 'active' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      class="theme-toggle"
      id="themeToggle"
      aria-label="Toggle dark mode"
      title="Toggle dark mode">{site.nav.themeLabel}</button
    >
  </div>
</header>

<script>
  const toggle = document.getElementById('themeToggle');
  const root = document.documentElement;
  const media = window.matchMedia?.('(prefers-color-scheme: dark)');

  function stored(): string | null {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  }

  // No attribute means the visitor has not chosen and the OS is in charge.
  function effective(): string {
    return root.getAttribute('data-theme') ?? (media?.matches ? 'dark' : 'light');
  }

  function paintToggle() {
    toggle?.setAttribute('data-theme', effective());
  }

  function choose(theme: string) {
    root.setAttribute('data-theme', theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* private mode — the choice lasts for this page only */
    }
    paintToggle();
  }

  paintToggle();
  toggle?.addEventListener('click', () => choose(effective() === 'dark' ? 'light' : 'dark'));

  // Until the toggle is clicked, follow the system live — the square in the
  // toggle has to keep up with a mid-visit OS switch.
  media?.addEventListener('change', () => {
    if (!stored()) paintToggle();
  });

  // Underline the nav link whose target matches the current hash. No hash (or a
  // hash no link points at) leaves the server-rendered link underlined.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav.nav a[href*="#"]'));

  function syncActive() {
    const match = links.find((link) => link.hash !== '' && link.hash === location.hash);
    if (!match) return;
    for (const link of links) link.classList.toggle('active', link === match);
  }

  window.addEventListener('hashchange', syncActive);
  syncActive();
</script>
