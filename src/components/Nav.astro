---
import site from '../config/site';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<header class="row masthead">
  <div class="cell c12">
    <a class="brand" href="/">{site.nav.brand}</a>
    <nav class="nav mono">
      {
        site.nav.links.map((link) => (
          <a href={link.href} class={link.id && link.id === active ? 'active' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      class="theme-toggle"
      id="themeToggle"
      data-theme={site.defaultTheme}
      aria-label="Toggle dark mode"
      title="Toggle dark mode">{site.nav.themeLabel}</button
    >
  </div>
</header>

<script>
  const toggle = document.getElementById('themeToggle');
  const root = document.documentElement;

  function apply(theme: string) {
    root.setAttribute('data-theme', theme);
    toggle?.setAttribute('data-theme', theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* private mode — the theme lasts for this page only */
    }
  }

  apply(root.getAttribute('data-theme') ?? 'light');
  toggle?.addEventListener('click', () => {
    apply(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
  });

  // Underline the nav link whose target matches the current hash. No hash (or a
  // hash no link points at) leaves the server-rendered link underlined.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav.nav a[href*="#"]'));

  function syncActive() {
    const match = links.find((link) => link.hash !== '' && link.hash === location.hash);
    if (!match) return;
    for (const link of links) link.classList.toggle('active', link === match);
  }

  window.addEventListener('hashchange', syncActive);
  syncActive();
</script>
