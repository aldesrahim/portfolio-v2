---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Sheet from '../../layouts/Sheet.astro';
import Rail from '../../components/Rail.astro';
import Slider from '../../components/Slider.astro';
import site from '../../config/site';
import { getProjects, pad } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, number: i + 1 },
  }));
}) satisfies GetStaticPaths;

const { project, number } = Astro.props;
const { data, images } = project;
const { Content } = await render(project.entry);
---

<Sheet title={`${data.title} — ${site.titleSuffix}`} description={data.description}>
  <div class="row back">
    <div class="cell c12">
      <a class="mono link" href="/#work">{site.project.backLabel}</a>
    </div>
  </div>

  <section class="row detail">
    <Rail num={pad(number)} label={data.year} sub={data.client} />
    <div class="cell c5">
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
    </div>
    <div class="cell c4 side">
      {
        data.stack.length > 0 && (
          <ul class="mono chips">
            {data.stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      <div class="links-row">
        {
          data.liveUrl && (
            <a class="mono link" href={data.liveUrl} target="_blank" rel="noopener">
              {site.project.liveLabel}
            </a>
          )
        }
        {
          data.repoUrl && (
            <a class="mono link" href={data.repoUrl} target="_blank" rel="noopener">
              {site.project.repoLabel}
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="row gallery">
    <div class="cell c12">
      <Slider images={images} eager />
    </div>
  </section>

  <section class="row about">
    <Rail label={site.project.aboutLabel} />
    <div class="cell c9">
      <div class="body-copy">
        <Content />
      </div>
    </div>
  </section>
</Sheet>
