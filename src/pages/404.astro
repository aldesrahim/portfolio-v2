---
import Sheet from '../layouts/Sheet.astro';
import Rail from '../components/Rail.astro';
import site from '../config/site';
---

<Sheet title={`Not found — ${site.titleSuffix}`} description="Page not found.">
  <section class="row detail">
    <Rail num="404" label="Not found" />
    <div class="cell c5">
      <h1>No such page</h1>
      <p class="lede">That entry is not in the index.</p>
    </div>
    <div class="cell c4 side">
      <div class="links-row">
        <a class="mono link" href="/">Back to the index <span>→</span></a>
      </div>
    </div>
  </section>
</Sheet>
