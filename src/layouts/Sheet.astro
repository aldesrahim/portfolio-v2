---
import { Font } from 'astro:assets';
import site from '../config/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Nav link to underline (matches `nav.links[].id` in the config). */
  active?: string;
}

const { title, description = site.description, active } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost/');
---

<!doctype html>
<html lang={site.lang} data-theme={site.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" preload />
    <script is:inline define:vars={{ fallback: site.defaultTheme }}>
      // Set the theme before first paint so the sheet never flashes.
      try {
        var stored = localStorage.getItem('theme');
        document.documentElement.setAttribute('data-theme', stored || fallback);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', fallback);
      }
    </script>
  </head>
  <body>
    <div class="sheet">
      <Nav active={active} />
      <slot />
      <Footer />
    </div>
  </body>
</html>
